<div class="space-y-12 max-w-5xl mx-auto">
  {{!-- Hero Section --}}
  <div class="text-center space-y-4 py-8">
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-neutral-50 via-neutral-100 to-indigo-300">
      Workflow Utility Suite
    </h1>
    <p class="text-neutral-400 text-lg max-w-2xl mx-auto font-medium">
      A collection of utility tools designed for high-performance development, media processing, and VR configuration.
    </p>
  </div>

  {{!-- Tool Grid --}}
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    
    {{!-- SeedVR2 Card --}}
    <div class="group relative rounded-2xl border border-neutral-800 bg-neutral-900/50 p-6 hover:bg-neutral-900 hover:border-neutral-700/80 transition-all duration-300 shadow-xl flex flex-col justify-between overflow-hidden">
      {{!-- Decorative background glow --}}
      <div class="absolute -right-16 -top-16 w-32 h-32 bg-indigo-500/10 rounded-full blur-3xl group-hover:bg-indigo-500/20 transition-colors duration-500"></div>

      <div class="space-y-4">
        {{!-- Icon --}}
        <div class="w-12 h-12 rounded-xl bg-indigo-500/10 flex items-center justify-center border border-indigo-500/20 text-indigo-400 group-hover:scale-105 transition-transform duration-300">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
        </div>

        {{!-- Text Content --}}
        <div class="space-y-2">
          <div class="flex items-center space-x-2">
            <span class="px-2 py-0.5 text-xs font-semibold bg-indigo-500/10 text-indigo-400 rounded border border-indigo-500/20">VR / Media</span>
            <span class="px-2 py-0.5 text-xs font-semibold bg-emerald-500/10 text-emerald-400 rounded border border-emerald-500/20">Ready</span>
          </div>
          <h2 class="text-xl font-bold text-neutral-100 group-hover:text-white transition-colors">
            SeedVR2 Resolution Calculator
          </h2>
          <p class="text-neutral-400 text-sm leading-relaxed">
            Scale the shortest edge to your target resolution while maintaining aspect ratio. Compute megapixels and final output dimensions.
          </p>
        </div>
      </div>

      {{!-- Button/Link --}}
      <div class="mt-8 pt-4 border-t border-neutral-800/40">
        <LinkTo @route="seedvr2_resolution_calculator" class="w-full inline-flex items-center justify-center px-4 py-2.5 rounded-xl text-sm font-semibold bg-neutral-800 text-neutral-200 group-hover:bg-indigo-600 group-hover:text-white hover:shadow-lg hover:shadow-indigo-500/20 active:scale-95 transition-all duration-200">
          <span>Launch Tool</span>
          <svg class="w-4 h-4 ml-1.5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </LinkTo>
      </div>
    </div>

    {{!-- Placeholder for Future Tools --}}
    <div class="rounded-2xl border border-dashed border-neutral-800 bg-transparent p-6 flex flex-col items-center justify-center text-center space-y-3 min-h-[250px]">
      <div class="w-12 h-12 rounded-xl bg-neutral-900 border border-neutral-800 flex items-center justify-center text-neutral-600">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
      </div>
      <div>
        <p class="text-sm font-semibold text-neutral-500">More Tools Coming Soon</p>
        <p class="text-xs text-neutral-600 mt-1 max-w-[200px]">Have a specific calculation or automation you need? Let us know!</p>
      </div>
    </div>

  </div>
</div>
